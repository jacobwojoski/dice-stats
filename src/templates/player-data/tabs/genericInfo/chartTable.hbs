<!--
Total Rolls: 
Mean (Avg)                  Expected Avg:
Median (Middle Number)      Mode (Most Common)
Streak 
-->
<section style="width: 100%; height:fit-content;">
    <h2>{{this.chartTitle}}</h2>
    <canvas id="{{this.chartId}}" width="400px" height="200px"></canvas>
    <table class="">
        <tr>
            <td>{{localize "DiceStats.Forms.PlayerData.GenericInfo.DiceInfo.Common.Total"}}</td>
            <td>{{this.totalRolls}}</td>
        </tr>

        <tr>
            <td>{{localize "DiceStats.Forms.PlayerData.GenericInfo.DiceInfo.Common.CalculatedMean"}}</td>
            <td>{{this.mean}}</td>

            <td>{{localize "DiceStats.Forms.PlayerData.GenericInfo.DiceInfo.Common.ExpectedMean"}}</td>
            <td>{{this.expectedMean}}</td>
        </tr>

        <tr>
            <td>{{localize "DiceStats.Forms.PlayerData.GenericInfo.DiceInfo.Common.Median"}}</td>
            <td>{{this.median}}</td>

            <td>{{localize "DiceStats.Forms.PlayerData.GenericInfo.DiceInfo.Common.Mode"}}</td>
            <td>{{this.mode}}</td>
        </tr>

        <tr>
            <td>{{localize "DiceStats.Forms.PlayerData.GenericInfo.DiceInfo.Common.Streak"}}</td>
            <td>{{this.streak}}</td>
        </tr>
    </table>
</section>