<section
  class='tab {{tab.cssClass}}'
  data-group='primary'
  data-tab='genericData'
  style='overflow-y: auto'
>   
  <h1>Generic Tab Data Here!</h1>
  <h3>{{this.customHeading}}</h3>

  <canvas id="myChart" width="400" height="200"></canvas>
  <!-- modules/dice-stats/templates/player-data/tabs/genericInfo -->
  <hr>

  <!-- D2 Info -->
  {{#if d2.isDisplayed}}
    {{> modules/dice-stats/templates/player-data/tabs/genericInfo/diceChart.hbs d2}}
    {{> modules/dice-stats/templates/player-data/tabs/genericInfo/chartTable.hbs d2}}
  {{/if}}

  <!-- D3 Info -->
  {{#if d3.isDisplayed}}
    {{> modules/dice-stats/templates/player-data/tabs/genericInfo/diceChart.hbs d3}}
    <canvas id="DiceStatsPlayerChartD3" width="400" height="200"></canvas>
    {{> modules/dice-stats/templates/player-data/tabs/genericInfo/chartTable.hbs d3}}
  {{/if}}

  <!-- D4 Info -->
